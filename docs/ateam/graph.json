  {"entries": 3, "first": "J-0031", "id": "REQ-004", "kind": "REQ", "last": "J-0042", "src": "docs/ateam/HISTORY.md:985", "status": "awaiting evaluation", "title": "Update the aGrUM version in use (the repository vendors 2.3.2) and expand support to more of aGrUM's model families, to explore new ways of conducting decision…"},
