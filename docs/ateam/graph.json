  {"entries": 1, "first": "J-0001", "id": "ADR-0001", "kind": "ADR", "last": "J-0001", "src": "docs/ateam/HISTORY.md:7", "status": "accepted", "title": "Secrets reach the components as Config UPROPERTYs read from DefaultGame.ini, never as literals in source"},
  {"entries": 1, "first": "J-0002", "id": "ADR-0002", "kind": "ADR", "last": "J-0002", "src": "docs/ateam/HISTORY.md:33", "status": "accepted", "title": "Synthesized speech is buffered per call and consumed by a paced, ordered consumer that signals end of turn, rather than played as it arrives"},
  {"entries": 1, "first": "J-0003", "id": "ADR-0003", "kind": "ADR", "last": "J-0003", "src": "docs/ateam/HISTORY.md:61", "status": "accepted", "title": "Neo4j speaks Bolt over plain TCP by default; WebSocket framing stays as an alternative transport"},
  {"entries": 1, "first": "J-0004", "id": "ADR-0004", "kind": "ADR", "last": "J-0004", "src": "docs/ateam/HISTORY.md:90", "status": "accepted", "title": "The AWS and Azure components are absent, not deprecated: no vendor SDK is carried"},
  {"entries": 1, "first": "J-0005", "id": "ADR-0005", "kind": "ADR", "last": "J-0005", "src": "docs/ateam/HISTORY.md:115", "status": "accepted", "title": "Audio2Face lip-sync lives in a separate optional plugin, so the core plugin never references NVIDIA ACE"},
  {"entries": 1, "first": "J-0006", "id": "ADR-0006", "kind": "ADR", "last": "J-0006", "src": "docs/ateam/HISTORY.md:143", "status": "accepted", "title": "Whisper GPU support is runtime dispatch to a separately built shared library, not a compile-time switch"},
  {"entries": 1, "first": "J-0007", "id": "ADR-0007", "kind": "ADR", "last": "J-0007", "src": "docs/ateam/HISTORY.md:169", "status": "accepted", "title": "Models, GPU stacks, build-time static libraries and vendor bundles are published as release assets and fetched by bootstrap"},
  {"entries": 1, "first": "J-0008", "id": "ADR-0008", "kind": "ADR", "last": "J-0008", "src": "docs/ateam/HISTORY.md:193", "status": "accepted", "title": "Bootstrap installs the whole turnkey stack by default and is narrowed by opt-out flags"},
  {"entries": 1, "first": "J-0009", "id": "ADR-0009", "kind": "ADR", "last": "J-0009", "src": "docs/ateam/HISTORY.md:223", "status": "accepted", "title": "aGrUM is vendored as per-module static libraries, linked ID then BN then BASE"},
  {"entries": 1, "first": "J-0010", "id": "ADR-0010", "kind": "ADR", "last": "J-0010", "src": "docs/ateam/HISTORY.md:249", "status": "accepted", "title": "Word and character timing from ElevenLabs is captured internally but not exposed to Blueprints"},
